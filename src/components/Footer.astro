<footer id="contact" class="py-16 bg-off-white border-t border-gray-100">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-3">Contact</h2>
        <a
          href="mailto:hello@zondostudios.com"
          class="text-lg font-medium text-charcoal hover:text-teal-700 transition-colors duration-200"
        >
          hello@zondostudios.com
        </a>
      </div>
      <div class="sm:text-right">
        <img src="/brand/zondo-lockup-horizontal.svg" alt="Zondo Studios" class="h-8 w-auto sm:ml-auto" />
        <p class="text-xs text-gray-500 mt-2">Australia</p>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-xs text-gray-500">&copy; {new Date().getFullYear()} Zondo Studios. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/privacy" class="text-xs text-gray-500 hover:text-teal-700 transition-colors duration-200">Privacy</a>
        <a href="/terms" class="text-xs text-gray-500 hover:text-teal-700 transition-colors duration-200">Terms</a>
        <a href="/brand" class="text-xs text-gray-500 hover:text-teal-700 transition-colors duration-200">Brand</a>
      </div>
    </div>
  </div>
</footer>
