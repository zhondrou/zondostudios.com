---
interface Props {
  variant?: "default" | "jarrah";
}

const { variant = "default" } = Astro.props;
const isJarrah = variant === "jarrah";
---

<nav class:list={[
  "fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b",
  isJarrah ? "bg-jarrah-dark/80 border-gray-800/80" : "bg-white/80 border-gray-100/80"
]}>
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-0">
      <span class:list={[
        "text-lg font-extrabold tracking-[0.2em] uppercase",
        isJarrah ? "text-white" : "text-near-black"
      ]}>Zondo</span>
      <span class="text-lg font-light tracking-[0.08em] text-gray-500 uppercase ml-1.5">Studios</span>
    </a>
    <div class="hidden sm:flex items-center gap-8">
      {isJarrah ? (
        <a href="/" class="text-sm font-medium text-gray-500 hover:text-white transition-colors duration-200">Studio</a>
        <a href="#features" class="text-sm font-medium text-gray-500 hover:text-white transition-colors duration-200">Features</a>
        <a href="#contact" class="text-sm font-medium text-gray-500 hover:text-white transition-colors duration-200">Contact</a>
      ) : (
        <a href="/#about" class="text-sm font-medium text-gray-500 hover:text-near-black transition-colors duration-200">About</a>
        <a href="/#products" class="text-sm font-medium text-gray-500 hover:text-near-black transition-colors duration-200">Products</a>
        <a href="/#contact" class="text-sm font-medium text-gray-500 hover:text-near-black transition-colors duration-200">Contact</a>
      )}
    </div>
  </div>
</nav>
