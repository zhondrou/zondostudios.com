---

<section id="products" class="py-32">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-16" data-animate>Products</h2>

    <!-- Jarrah Money teaser -->
    <a href="/jarrah" class="group block rounded-2xl border border-gray-100 p-8 sm:p-12 hover:border-emerald-600/30 hover:shadow-[0_0_40px_-10px_rgba(5,150,105,0.1)] hover:-translate-y-0.5 transition-all duration-300" data-animate>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <img src="/jarrahlogodark.png" alt="Jarrah Money" class="h-7" />
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-600">
              In Development
            </span>
          </div>
          <p class="text-lg text-gray-500 max-w-lg">
            Personal finance, simplified. Connect your bank accounts, track spending, manage investments, and build AI-assisted budgets — all in one place. Built for Australia.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="font-mono text-xs text-gray-500 bg-off-white px-3 py-1.5 rounded-full">Bank sync</span>
            <span class="font-mono text-xs text-gray-500 bg-off-white px-3 py-1.5 rounded-full">AI budgeting</span>
            <span class="font-mono text-xs text-gray-500 bg-off-white px-3 py-1.5 rounded-full">Investments</span>
            <span class="font-mono text-xs text-gray-500 bg-off-white px-3 py-1.5 rounded-full">Australian-first</span>
          </div>
        </div>
        <div class="flex-shrink-0">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-near-black group-hover:text-emerald-600 transition-colors duration-200">
            Learn more
            <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
