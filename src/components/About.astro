<section id="about" class="py-32 bg-off-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="max-w-2xl" data-animate>
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-4">About</h2>
      <p class="text-2xl sm:text-3xl font-semibold leading-snug tracking-tight gradient-text">
        Independent. Full-stack. Shipping real products.
      </p>
      <div class="mt-8 space-y-5 text-gray-500 leading-relaxed">
        <p>
          Zondo Studios is an independent software studio based in Australia. We design, build, and ship applications end-to-end — from idea through to production.
        </p>
        <p>
          Small means fast. Every line of code has intent. No committees, no handoffs, no bloat.
        </p>
      </div>
    </div>
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4" data-animate-stagger>
      <div class="rounded-xl border border-gray-100 bg-white p-6 hover:border-emerald-600/30 hover:shadow-[0_0_20px_-5px_rgba(5,150,105,0.1)] transition-all duration-300" data-animate style="--stagger-index: 0">
        <div class="text-sm font-semibold text-near-black mb-1">Fintech</div>
        <p class="text-sm text-gray-500 leading-relaxed">Bank integrations, financial data, AI-powered planning tools.</p>
      </div>
      <div class="rounded-xl border border-gray-100 bg-white p-6 hover:border-emerald-600/30 hover:shadow-[0_0_20px_-5px_rgba(5,150,105,0.1)] transition-all duration-300" data-animate style="--stagger-index: 1">
        <div class="text-sm font-semibold text-near-black mb-1">Mobile & Web</div>
        <p class="text-sm text-gray-500 leading-relaxed">Cross-platform apps built for performance and usability.</p>
      </div>
      <div class="rounded-xl border border-gray-100 bg-white p-6 hover:border-emerald-600/30 hover:shadow-[0_0_20px_-5px_rgba(5,150,105,0.1)] transition-all duration-300" data-animate style="--stagger-index: 2">
        <div class="text-sm font-semibold text-near-black mb-1">AI & Automation</div>
        <p class="text-sm text-gray-500 leading-relaxed">Intelligent features powered by modern language models.</p>
      </div>
    </div>
  </div>
</section>
