---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Zondo Studios Brand Kit"
  description="Brand guidelines, logos, and assets for Zondo Studios."
>
  <Nav />

  <section class="pt-32 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight gradient-text">Brand Kit</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-lg">Guidelines, logos, and assets for Zondo Studios.</p>
    </div>
  </section>

  <!-- Color Palette -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Color Palette</h2>

      <!-- Brand gradients -->
      <div class="space-y-6">
        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Teal — primary</p>
          <div class="h-16 rounded-xl" style="background: linear-gradient(to right, #56C7C0 0%, #2A86A8 55%, #1E5A8E 100%);"></div>
          <div class="mt-3 grid grid-cols-3 gap-4 text-xs font-mono text-gray-500">
            <span>#56C7C0 &middot; 500</span>
            <span class="text-center">#2A86A8 &middot; 600</span>
            <span class="text-right">#1E5A8E &middot; 700</span>
          </div>
        </div>

        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Coral — secondary</p>
          <div class="h-16 rounded-xl" style="background: linear-gradient(to right, #F2BC9C 0%, #E8865B 55%, #C0533F 100%);"></div>
          <div class="mt-3 grid grid-cols-3 gap-4 text-xs font-mono text-gray-500">
            <span>#F2BC9C &middot; 500</span>
            <span class="text-center">#E8865B &middot; 600</span>
            <span class="text-right">#C0533F &middot; 700</span>
          </div>
        </div>
      </div>

      <!-- Supporting -->
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div>
          <div class="aspect-square rounded-xl" style="background: #0F1115;"></div>
          <p class="mt-2 text-sm font-semibold text-charcoal">Charcoal</p>
          <p class="text-xs text-gray-500 font-mono">#0F1115</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl border border-gray-100" style="background: #FAFAFA;"></div>
          <p class="mt-2 text-sm font-semibold text-charcoal">Off-white</p>
          <p class="text-xs text-gray-500 font-mono">#FAFAFA</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl" style="background: #6B7280;"></div>
          <p class="mt-2 text-sm font-semibold text-charcoal">Gray</p>
          <p class="text-xs text-gray-500 font-mono">#6B7280</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl" style="background: #E8F4F7;"></div>
          <p class="mt-2 text-sm font-semibold text-charcoal">Teal Tint</p>
          <p class="text-xs text-gray-500 font-mono">#E8F4F7</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mark Construction -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-3">Mark Construction</h2>
      <p class="text-gray-500 mb-8 max-w-lg">Two layered Z-shapes — a coral back layer and a teal front layer — combine into a single mark with depth.</p>
      <div class="grid grid-cols-3 gap-4 sm:gap-6 items-center">
        <div class="border border-gray-100 rounded-2xl p-6 sm:p-10 flex items-center justify-center bg-white aspect-square">
          <img src="/brand/zondo-mark-mono-light.svg" alt="Back layer (coral position)" class="w-full h-auto max-w-[140px]" style="filter: hue-rotate(0deg);" />
        </div>
        <div class="text-center text-3xl text-gray-500 font-light">+</div>
        <div class="border border-gray-100 rounded-2xl p-6 sm:p-10 flex items-center justify-center bg-white aspect-square">
          <img src="/brand/zondo-mark.svg" alt="Composed mark" class="w-full h-auto max-w-[140px]" />
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">Layered geometry &middot; gradient depth &middot; soft rounded joins</p>
    </div>
  </section>

  <!-- Mark Variants -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Mark</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="border border-gray-100 rounded-2xl p-10 flex items-center justify-center aspect-square bg-white">
          <img src="/brand/zondo-mark.svg" alt="Zondo mark, full color" class="w-32 h-32" />
        </div>
        <div class="rounded-2xl p-10 flex items-center justify-center aspect-square" style="background: #0F1115;">
          <img src="/brand/zondo-mark-mono-light.svg" alt="Zondo mark, white on dark" class="w-32 h-32" />
        </div>
        <div class="border border-gray-100 rounded-2xl p-10 flex items-center justify-center aspect-square bg-white">
          <img src="/brand/zondo-mark-mono-dark.svg" alt="Zondo mark, dark on light" class="w-32 h-32" />
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">
        Downloads:
        <a href="/brand/zondo-mark.svg" class="text-teal-700 hover:underline" download>Color SVG</a> &middot;
        <a href="/brand/zondo-mark.png" class="text-teal-700 hover:underline" download>Color PNG</a> &middot;
        <a href="/brand/zondo-mark-mono-dark.svg" class="text-teal-700 hover:underline" download>Mono dark</a> &middot;
        <a href="/brand/zondo-mark-mono-light.svg" class="text-teal-700 hover:underline" download>Mono light</a>
      </p>
    </div>
  </section>

  <!-- Lockups -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Lockups</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="border border-gray-100 rounded-2xl p-10 flex items-center justify-center bg-white aspect-[4/3]">
          <img src="/brand/zondo-lockup-horizontal.svg" alt="Zondo horizontal lockup" class="w-full max-w-[280px] h-auto" />
        </div>
        <div class="border border-gray-100 rounded-2xl p-10 flex items-center justify-center bg-white aspect-[4/3]">
          <img src="/brand/zondo-lockup-stacked.svg" alt="Zondo stacked lockup" class="h-full max-h-[200px] w-auto" />
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">
        Downloads:
        <a href="/brand/zondo-lockup-horizontal.svg" class="text-teal-700 hover:underline" download>Horizontal SVG</a> &middot;
        <a href="/brand/zondo-lockup-horizontal.png" class="text-teal-700 hover:underline" download>Horizontal PNG</a> &middot;
        <a href="/brand/zondo-lockup-stacked.svg" class="text-teal-700 hover:underline" download>Stacked SVG</a> &middot;
        <a href="/brand/zondo-lockup-stacked.png" class="text-teal-700 hover:underline" download>Stacked PNG</a>
      </p>
    </div>
  </section>

  <!-- Typography -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Typography</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Primary, Inter</p>
          <p class="text-4xl font-extrabold tracking-tight text-charcoal">Extrabold 800</p>
          <p class="text-3xl font-bold tracking-tight text-charcoal mt-2">Bold 700</p>
          <p class="text-2xl font-semibold text-charcoal mt-2">Semibold 600</p>
          <p class="text-xl font-medium text-charcoal mt-2">Medium 500</p>
          <p class="text-lg text-charcoal mt-2">Regular 400</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Usage</p>
          <div class="space-y-4">
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Headings</span>
              <span class="font-bold text-charcoal">Inter Bold / Extrabold</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Body</span>
              <span class="text-gray-500">Inter Regular / Medium</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Labels</span>
              <span class="text-sm font-semibold tracking-wide uppercase text-teal-600">Inter Semibold, Uppercase</span>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Logo</span>
              <img src="/brand/zondo-lockup-horizontal.svg" alt="Zondo Studios" class="h-7 w-auto" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Usage Guidelines -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Usage Guidelines</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
        <div>
          <h3 class="font-bold text-charcoal mb-3">Do</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2">
              <span class="text-teal-700 mt-0.5">&#10003;</span>
              Preserve the gradient direction on the mark
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal-700 mt-0.5">&#10003;</span>
              Maintain generous clear space around the lockup
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal-700 mt-0.5">&#10003;</span>
              Use the mono variants when context requires single-color reproduction
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal-700 mt-0.5">&#10003;</span>
              Use the mark alone for small formats (favicons, app icons, avatars)
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-charcoal mb-3">Don't</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2">
              <span class="text-coral-700 mt-0.5">&#10005;</span>
              Recolor or flatten the gradient of the mark
            </li>
            <li class="flex items-start gap-2">
              <span class="text-coral-700 mt-0.5">&#10005;</span>
              Place the mark on busy or low-contrast backgrounds
            </li>
            <li class="flex items-start gap-2">
              <span class="text-coral-700 mt-0.5">&#10005;</span>
              Stretch, rotate, or apply effects to the lockup
            </li>
            <li class="flex items-start gap-2">
              <span class="text-coral-700 mt-0.5">&#10005;</span>
              Re-typeset the wordmark in a different typeface
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Voice -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-teal-600 tracking-wide uppercase mb-8">Brand Voice</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-charcoal mb-2">Confident, not loud</h3>
          <p class="text-sm text-gray-500 leading-relaxed">We let the work speak. No hype, no buzzwords, no exclamation marks. Clear, direct statements.</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-charcoal mb-2">Technical, not jargony</h3>
          <p class="text-sm text-gray-500 leading-relaxed">We speak with precision. We explain complex things simply without dumbing them down.</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-charcoal mb-2">Independent, not scrappy</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Small by design, not by accident. We frame our size as focus, not limitation.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
