---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Zondo Studios — Brand Kit"
  description="Brand guidelines, logos, and assets for Zondo Studios."
>
  <Nav />

  <section class="pt-32 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight gradient-text">Brand Kit</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-lg">Guidelines, logos, and assets for Zondo Studios.</p>
    </div>
  </section>

  <!-- Colors -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Color Palette</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        <div>
          <div class="aspect-square rounded-xl bg-surface border border-gray-100"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Surface</p>
          <p class="text-xs text-gray-500 font-mono">#0A0A0A</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl bg-off-white border border-gray-100"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Elevated</p>
          <p class="text-xs text-gray-500 font-mono">#111111</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl bg-emerald-600"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Emerald</p>
          <p class="text-xs text-gray-500 font-mono">#059669</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl bg-emerald-500"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Emerald Light</p>
          <p class="text-xs text-gray-500 font-mono">#10B981</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl" style="background: #F5F5F5;"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Text Primary</p>
          <p class="text-xs text-gray-500 font-mono">#F5F5F5</p>
        </div>
        <div>
          <div class="aspect-square rounded-xl" style="background: #737373;"></div>
          <p class="mt-2 text-sm font-semibold text-near-black">Text Secondary</p>
          <p class="text-xs text-gray-500 font-mono">#737373</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Typography -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Typography</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Primary — Inter</p>
          <p class="text-4xl font-extrabold tracking-tight text-near-black">Extrabold 800</p>
          <p class="text-3xl font-bold tracking-tight text-near-black mt-2">Bold 700</p>
          <p class="text-2xl font-semibold text-near-black mt-2">Semibold 600</p>
          <p class="text-xl font-medium text-near-black mt-2">Medium 500</p>
          <p class="text-lg text-near-black mt-2">Regular 400</p>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-mono uppercase tracking-wide mb-3">Usage</p>
          <div class="space-y-4">
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Headings</span>
              <span class="font-bold text-near-black">Inter Bold / Extrabold</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Body</span>
              <span class="text-gray-500">Inter Regular / Medium</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Labels</span>
              <span class="text-sm font-semibold tracking-wide uppercase text-emerald-600">Inter Semibold, Uppercase</span>
            </div>
            <div class="flex items-baseline gap-4">
              <span class="text-xs text-gray-500 font-mono w-24 flex-shrink-0">Logo</span>
              <span class="font-extrabold tracking-[0.2em] uppercase text-near-black">ZONDO</span>
              <span class="font-light tracking-[0.08em] text-gray-500 uppercase">Studios</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wordmark -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Wordmark</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="border border-gray-100 rounded-2xl p-8 flex items-center justify-center aspect-[3/2] bg-white">
          <div>
            <span class="text-2xl font-extrabold tracking-[0.2em] text-near-black uppercase">Zondo</span>
            <span class="text-2xl font-light tracking-[0.08em] text-gray-500 uppercase ml-2">Studios</span>
          </div>
        </div>
        <div class="bg-off-white border border-gray-100 rounded-2xl p-8 flex items-center justify-center aspect-[3/2]">
          <div>
            <span class="text-2xl font-extrabold tracking-[0.2em] text-white uppercase">Zondo</span>
            <span class="text-2xl font-light tracking-[0.08em] text-white/50 uppercase ml-2">Studios</span>
          </div>
        </div>
        <div class="bg-emerald-600 rounded-2xl p-8 flex items-center justify-center aspect-[3/2]">
          <div>
            <span class="text-2xl font-extrabold tracking-[0.2em] text-white uppercase">Zondo</span>
            <span class="text-2xl font-light tracking-[0.08em] text-white/60 uppercase ml-2">Studios</span>
          </div>
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">SVG downloads: <a href="/brand/zondo-wordmark-dark.svg" class="text-emerald-600 hover:underline" download>Dark</a> &middot; <a href="/brand/zondo-wordmark-light.svg" class="text-emerald-600 hover:underline" download>Light</a> &middot; <a href="/brand/zondo-wordmark-emerald.svg" class="text-emerald-600 hover:underline" download>Emerald</a></p>
    </div>
  </section>

  <!-- Icon Mark -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Icon Mark</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div class="border border-gray-100 rounded-2xl p-8 flex items-center justify-center">
          <img src="/brand/zondo-icon-dark.svg" alt="Zondo icon dark" class="w-20 h-20" />
        </div>
        <div class="border border-gray-100 rounded-2xl p-8 flex items-center justify-center">
          <img src="/brand/zondo-icon-emerald.svg" alt="Zondo icon emerald" class="w-20 h-20" />
        </div>
        <div class="bg-white rounded-2xl p-8 flex items-center justify-center">
          <img src="/brand/zondo-icon-light.svg" alt="Zondo icon light" class="w-20 h-20" />
        </div>
        <div class="border border-gray-100 rounded-2xl p-8 flex items-center justify-center">
          <img src="/brand/zondo-icon-dark.svg" alt="Zondo icon on dark" class="w-20 h-20" />
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">SVG downloads: <a href="/brand/zondo-icon-dark.svg" class="text-emerald-600 hover:underline" download>Dark</a> &middot; <a href="/brand/zondo-icon-emerald.svg" class="text-emerald-600 hover:underline" download>Emerald</a> &middot; <a href="/brand/zondo-icon-light.svg" class="text-emerald-600 hover:underline" download>Light</a></p>
    </div>
  </section>

  <!-- Lockup -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Lockup</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="border border-gray-100 rounded-2xl p-12 flex items-center gap-5">
          <img src="/brand/zondo-icon-dark.svg" alt="Zondo icon" class="w-16 h-16 flex-shrink-0" />
          <div>
            <div class="text-xl font-extrabold tracking-[0.2em] text-near-black uppercase">Zondo</div>
            <div class="text-xs font-light tracking-[0.15em] text-gray-500 uppercase">Studios</div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-12 flex items-center gap-5">
          <img src="/brand/zondo-icon-light.svg" alt="Zondo icon light" class="w-16 h-16 flex-shrink-0" />
          <div>
            <div class="text-xl font-extrabold tracking-[0.2em] text-near-black uppercase">Zondo</div>
            <div class="text-xs font-light tracking-[0.15em] text-gray-500 uppercase">Studios</div>
          </div>
        </div>
      </div>
      <p class="mt-4 text-xs text-gray-500 font-mono">SVG downloads: <a href="/brand/zondo-lockup-dark.svg" class="text-emerald-600 hover:underline" download>Dark</a> &middot; <a href="/brand/zondo-lockup-light.svg" class="text-emerald-600 hover:underline" download>Light</a></p>
    </div>
  </section>

  <!-- Usage Guidelines -->
  <section class="py-16 bg-off-white">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Usage Guidelines</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12">
        <div>
          <h3 class="font-bold text-near-black mb-3">Do</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5">&#10003;</span>
              Use the wordmark on clean, uncluttered backgrounds
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5">&#10003;</span>
              Maintain generous clear space around the logo
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5">&#10003;</span>
              Use the icon mark for small formats (favicons, app icons, avatars)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5">&#10003;</span>
              Use the light variant on dark backgrounds, dark on light
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-near-black mb-3">Don't</h3>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">&#10005;</span>
              Alter the letter-spacing or font weight of the wordmark
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">&#10005;</span>
              Place the logo on busy or low-contrast backgrounds
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">&#10005;</span>
              Stretch, rotate, or apply effects to the logo
            </li>
            <li class="flex items-start gap-2">
              <span class="text-red-500 mt-0.5">&#10005;</span>
              Use colors outside the defined palette
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand Values -->
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-sm font-semibold text-emerald-600 tracking-wide uppercase mb-8">Brand Voice</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-near-black mb-2">Confident, not loud</h3>
          <p class="text-sm text-gray-500 leading-relaxed">We let the work speak. No hype, no buzzwords, no exclamation marks. Clear, direct statements.</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-near-black mb-2">Technical, not jargony</h3>
          <p class="text-sm text-gray-500 leading-relaxed">We speak with precision. We explain complex things simply without dumbing them down.</p>
        </div>
        <div class="rounded-xl border border-gray-100 bg-white p-6">
          <h3 class="font-bold text-near-black mb-2">Independent, not scrappy</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Small by design, not by accident. We frame our size as focus, not limitation.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
